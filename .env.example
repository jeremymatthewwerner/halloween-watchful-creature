# Copy to .env and fill in. Never commit .env.

# Required: your OpenAI project API key (stays on the server, never sent to the browser).
OPENAI_API_KEY=sk-...

# Which character to run: pumpkin | reginald | raven (files in prompts/characters/).
CHARACTER=pumpkin

# Voice engine: "live" (GPT-Live, default) or "realtime" (gpt-realtime-2.x, native image input).
ENGINE=live
LIVE_MODEL=gpt-live-1
REALTIME_MODEL=gpt-realtime-2.1

# Vision model that describes costumes for GPT-Live (any vision-capable Responses model).
VISION_MODEL=gpt-6-luna
# Reasoning effort for the vision model; leave empty for models without reasoning.
VISION_REASONING_EFFORT=low

# Optional fallback voice (e.g. vesper, gleam, meridian, marin, cedar): beats the character's
# default, but a voice picked in the dashboard's Voice picker overrides it.
VOICE=

# Body controller (Arduino over USB). "auto" finds an Arduino; "none" disables; or a path like /dev/tty.usbmodem1101
BODY_SERIAL_PORT=auto
# Comma-separated body modes: eyes, jaw, relay
BODY_MODES=eyes

# Behavior tuning
IDLE_CLOSE_SECONDS=180
# Safety cap on awake (billed) minutes per day; the creature sleeps when it's reached.
MAX_VOICE_MINUTES_PER_DAY=240
BACKGROUND_FRAME_SECONDS=30

# Daily logs (log.html, log.txt, greeting snapshots) go in this folder; "none" keeps no logs.
LOG_DIR=logs
# Save a camera snapshot of each greeting in the log.
LOG_SNAPSHOTS=true

# Rehearsal mode's "Generate visitors" (made-up trick-or-treater pictures, cached so each is paid for once).
REHEARSAL_IMAGE_MODEL=gpt-image-2.5-flare
REHEARSAL_IMAGE_QUALITY=low
REHEARSAL_IMAGE_SIZE=1536x1024
# Estimate shown before generating, in US dollars per image (the real cost is logged after).
REHEARSAL_IMAGE_COST_USD=0.01
# Folder for the cached images (gitignored); "none" turns generating off.
REHEARSAL_CACHE_DIR=rehearsal-cache

# Lure call-outs and offline greetings in the voice picked on the dashboard: made with OpenAI
# text-to-speech the first time a voice is used (about a cent) and cached in this folder (gitignored).
# "none" keeps only the bundled clips (web/public/lure/, web/public/greeting/).
CLIP_CACHE_DIR=clip-cache

PORT=8787

# Phone remote (README: "Phone remote and alerts"). Empty = off: the server only answers this computer.
# Set a PIN (6+ characters) to listen on your home network and open http://<this computer>:8787/remote on your phone.
REMOTE_PIN=
# Where to listen. Defaults to 127.0.0.1, or 0.0.0.0 when REMOTE_PIN is set; non-loopback needs REMOTE_PIN.
# HOST=

# Push alerts to your phone with the ntfy app (https://ntfy.sh). Empty = no pushes.
# Pick a long, random topic (anyone who knows it can read the alerts), e.g. jacques-<output of: openssl rand -hex 12>
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=
