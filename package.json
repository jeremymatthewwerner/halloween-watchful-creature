{
  "name": "halloween-watchful-creature",
  "version": "0.1.0",
  "private": true,
  "description": "A friendly porch creature that sees costumes, compliments them, and chats, powered by OpenAI GPT-Live.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "doctor": "tsx scripts/doctor.ts",
    "soak": "tsx scripts/soak/run.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@mediapipe/tasks-vision": "^1.1.1",
    "dotenv": "^18.0.8",
    "hono": "^4.13.13",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
